# Offline fixture mode or ordinary public HTTP search mode.
TUNEAGENT_MODE=mock

# Public Netease search endpoint used without request signing or encryption.
NETEASE_SEARCH_URL=https://music.163.com/api/search/get/web
NETEASE_SEARCH_LIMIT=20
HTTP_TIMEOUT_SECONDS=20

# Local application settings.
APP_PORT=3000
APP_UI_HOST=127.0.0.1
APP_UI_PORT=7860
DOWNLOAD_DIR=downloads
FIXTURE_PATH=tests/fixtures/raw_search_guofeng.json

# Optional real-download credentials. Never commit real values.
# NETEASE_COOKIE=MUSIC_U=replace_me; __csrf=replace_me
# NETEASE_MUSIC_U=replace_me
NETEASE_COOKIE_FILE=.netease_cookie
NETEASE_MAX_DOWNLOAD_BYTES=134217728

# Interactive Agent model configuration. Leave keys empty for offline mode.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_CONFIG=config/llm_models.toml
